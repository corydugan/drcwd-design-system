{
  "$schema": "https://design-tokens.org/format",
  "$description": "Dr. Cory Dugan brand design tokens v3 'Authority'. Tool-agnostic source for Figma (Tokens Studio), Canva, Tailwind, Style Dictionary. Generated from colors_and_type.css — that CSS file is the single source of truth; regenerate this when it changes.",
  "$meta": {
    "brand": "Dr. Cory Dugan (drCWDugan)",
    "version": "3.0.0",
    "supersedes": "v2 grape (2026-06-12) and v1 teal (retired)",
    "locked": ["grape #352051", "DM Serif Display", "DM Sans", "white-dominant editorial"]
  },
  "color": {
    "grape": {
      "900": { "$type": "color", "$value": "#1b112e" },
      "800": { "$type": "color", "$value": "#352051", "$description": "PRIMARY brand — links, numerals, key marks" },
      "700": { "$type": "color", "$value": "#4a2f70" },
      "600": { "$type": "color", "$value": "#6b4f9e" },
      "500": { "$type": "color", "$value": "#8a6fb8" },
      "200": { "$type": "color", "$value": "#d8cfe7", "$description": "data-baseline rule" },
      "100": { "$type": "color", "$value": "#ece8f3" },
      "050": { "$type": "color", "$value": "#f6f4fa" }
    },
    "ink": {
      "max": { "$type": "color", "$value": "#0B0B0C", "$description": "near-black — stat displays only" },
      "1000": { "$type": "color", "$value": "#1C1C1E" },
      "900": { "$type": "color", "$value": "#2A2A2D" },
      "700": { "$type": "color", "$value": "#4A4A4F" },
      "500": { "$type": "color", "$value": "#797A80" },
      "400": { "$type": "color", "$value": "#9CA0A6" },
      "300": { "$type": "color", "$value": "#C8CACE" },
      "200": { "$type": "color", "$value": "#E4E5E7" },
      "100": { "$type": "color", "$value": "#EFEFEF" },
      "050": { "$type": "color", "$value": "#F7F7F6" }
    },
    "paper": { "$type": "color", "$value": "#FFFFFF", "$description": "canvas — dominant surface" },
    "status": {
      "up": { "$type": "color", "$value": "#4a2f70" },
      "down": { "$type": "color", "$value": "#B5524A" },
      "warn": { "$type": "color", "$value": "#B58A3A" }
    },
    "dataviz": {
      "categorical": { "$type": "array", "$value": ["#352051", "#8a6fb8", "#797A80", "#B58A3A", "#B5524A"] },
      "sequential": { "$type": "array", "$value": ["#ece8f3", "#8a6fb8", "#6b4f9e", "#352051"] }
    }
  },
  "gradient": { "$value": "none", "$description": "By design — drCWDugan is flat editorial. Gradients belong to HolisticHer, not this brand." },
  "font": {
    "serif": { "$type": "fontFamily", "$value": "DM Serif Display", "$description": "display/headlines + signature italic" },
    "sans": { "$type": "fontFamily", "$value": "DM Sans", "$description": "body, UI, eyebrows, tabular stats" },
    "mono": { "$type": "fontFamily", "$value": "ui-monospace", "$description": "code + evidence voice (n=, p-values, CIs)" }
  },
  "fontSize": {
    "display-xl": { "$type": "dimension", "$value": "clamp(3.25rem,5.5vw,5.25rem)" },
    "display-lg": { "$type": "dimension", "$value": "clamp(2.5rem,4vw,3.75rem)" },
    "display-md": { "$type": "dimension", "$value": "clamp(2rem,3vw,2.75rem)" },
    "display-sm": { "$type": "dimension", "$value": "clamp(1.625rem,2vw,2rem)" },
    "stat": { "$type": "dimension", "$value": "clamp(2.5rem,4vw,3.75rem)", "$description": "tabular stat display" },
    "heading-lg": { "$type": "dimension", "$value": "1.5rem" },
    "heading-md": { "$type": "dimension", "$value": "1.25rem" },
    "heading-sm": { "$type": "dimension", "$value": "1.0625rem" },
    "body-lg": { "$type": "dimension", "$value": "1.125rem" },
    "body": { "$type": "dimension", "$value": "1rem" },
    "body-sm": { "$type": "dimension", "$value": "0.9375rem" },
    "meta": { "$type": "dimension", "$value": "0.8125rem" },
    "micro": { "$type": "dimension", "$value": "0.6875rem" }
  },
  "fontWeight": {
    "light": { "$value": 300 }, "regular": { "$value": 400 }, "medium": { "$value": 500 },
    "semibold": { "$value": 600 }, "bold": { "$value": 700 }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" }, "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" }, "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" }, "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }, "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }, "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" }, "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" }, "40": { "$type": "dimension", "$value": "160px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "2px" }, "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" }, "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "16px" }, "pill": { "$type": "dimension", "$value": "999px" }
  }
}
